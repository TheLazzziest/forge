{
  // OCX v2 registry manifest for Superpowers
  "$schema": "https://ocx.kdco.dev/schemas/v2/registry.json",
  "name": "Superpowers",
  "version": "5.1.0",
  "author": "Jesse Vincent / Prime Radiant",
  "openCode": "1.0.0",
