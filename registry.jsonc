{
  // OCX Registry Starter Template
  // Use this as a starting point for creating your own component registry
  //
  // Schema reference: https://ocx.kdco.dev/schemas/v2/registry.json
  // Documentation: https://github.com/kdcokenny/ocx

  "$schema": "https://ocx.kdco.dev/schemas/v2/registry.json",
  "name": "Forge",
  // Registry refs use the alias chosen by users via:
  // ocx registry add <url> --name <alias>
  "version": "0.0.1",
  "author": "TheLazzziest",

  // Compatibility versions
  "opencode": "1.0.0", // Minimum OpenCode version required
  "ocx": "1.0.16", // Minimum OCX CLI version required

  "components": [
    // Add your components here
    // Supported types:
    //   - skill     - Knowledge modules (markdown files)
    //   - agent     - AI personas with custom prompts
    //   - plugin    - TypeScript plugins that extend functionality
    //   - command   - User-invokable commands
    //   - tool      - Custom tool implementations
    //   - bundle    - Collections of related components
    //   - profile   - Shareable profile configuration
    {
      "name": "hello-world",
      "type": "skill",
      "description": "An example skill to get you started",
      "files": ["skills/hello-world/SKILL.md"],
    },
    {
      "name": "fpf",
      "type": "skill",
      "description": "First Principles Framework (FPF) — reasoning backbone for agents. Shapes cognitive defaults: partition bounded contexts, separate concerns, hold alternatives, tag evidence, produce aligned outputs. Load as foundation before any domain role skill.",
      "files": [
        "skills/fpf/SKILL.md",
        "skills/fpf/references/glossary.md",
        "skills/fpf/references/complexity-assessment.md",
        "skills/fpf/references/pattern-catalog.md",
        "skills/fpf/references/role-composition.md",
        "skills/fpf/references/drr-guidance.md",
        "skills/fpf/references/uts-guidance.md",
        "skills/fpf/references/evidence-guidance.md",
        "skills/fpf/assets/fpf-assessor-manifest.json",
        "skills/fpf/assets/schemas/prediction-log.schema.json",
        "skills/fpf/assets/schemas/session-observation.schema.json",
        "skills/fpf/assets/schemas/ab-experiment-config.schema.json",
        "skills/fpf/assets/schemas/decision-log.schema.json",
        "skills/fpf/assets/schemas/vocabulary-log.schema.json",
        "skills/fpf/assets/schemas/evidence-log.schema.json",
        "skills/fpf/assets/templates/prediction-log.jsonl",
        "skills/fpf/assets/templates/session-observations.json",
        "skills/fpf/assets/templates/decision-log.jsonl",
        "skills/fpf/assets/templates/vocabulary-log.jsonl",
        "skills/fpf/assets/templates/evidence-log.jsonl",
      ],
    },
    {
      "name": "developer",
      "type": "profile",
      "description": "Developer profile for Forge — iterative build from minimal shell",
      "files": [
        {
          "path": "profiles/developer/AGENTS.md",
          "target": "developer/AGENTS.md",
        },
        {
          "path": "profiles/developer/ocx.jsonc",
          "target": "developer/ocx.jsonc",
        },
        {
          "path": "profiles/developer/opencode.jsonc",
          "target": "developer/opencode.jsonc",
        },
      ],
      "dependencies": ["fpf"],
    },
  ],
}
