  "components": [
{
    "name": "superpowers-plugin",
    "type": "plugin",
    "description": "Superpowers bootstrap - auto-registers skills, injects context",
    "files": [
        ".opencode/plugins/superpowers.js"
    ],
    "dependencies": [],
    "opencode": {
        "skills": {
            "paths": [
                "skills/superpowers"
            ]
        }
    }
},
{
    "name": "implementer",
    "type": "agent",
    "description": "Subagent that implements tasks from plans with self-review and escalation",
